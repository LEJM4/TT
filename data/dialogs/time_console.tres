[gd_resource type="Resource" script_class="DialogData" format=3]

[ext_resource type="Script" path="res://dialogs/dialog_data.gd" id="1_data"]
[ext_resource type="Script" path="res://dialogs/dialog_line.gd" id="2_line"]
[ext_resource type="Script" path="res://dialogs/dialog_choice.gd" id="3_choice"]
[ext_resource type="Resource" path="res://data/dialogs/speakers/time_capsule.tres" id="4_speaker"]

[sub_resource type="Resource" id="Resource_choice_chamber"]
script = ExtResource("3_choice")
text = "Testkammer"
next = &"test_chamber"

[sub_resource type="Resource" id="Resource_choice_field"]
script = ExtResource("3_choice")
text = "Testfeld"
next = &"test_field"

[sub_resource type="Resource" id="Resource_choice_stay"]
script = ExtResource("3_choice")
text = "Hierbleiben"
next = &"end"

[sub_resource type="Resource" id="Resource_question"]
script = ExtResource("2_line")
id = &"question"
text = "Wohin soll die Reise gehen?"
choices = Array[ExtResource("3_choice")]([SubResource("Resource_choice_chamber"), SubResource("Resource_choice_field"), SubResource("Resource_choice_stay")])

[sub_resource type="Resource" id="Resource_chamber"]
script = ExtResource("2_line")
id = &"test_chamber"
text = "Ziel: Testkammer. Die Zeitkapsel startet."
next = &"end"
action = &"test_chamber"

[sub_resource type="Resource" id="Resource_field"]
script = ExtResource("2_line")
id = &"test_field"
text = "Ziel: Testfeld. Die Zeitkapsel startet."
next = &"end"
action = &"test_field"

[resource]
script = ExtResource("1_data")
speaker = ExtResource("4_speaker")
lines = Array[ExtResource("2_line")]([SubResource("Resource_question"), SubResource("Resource_chamber"), SubResource("Resource_field")])
