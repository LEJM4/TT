[gd_resource type="Resource" script_class="DialogData" format=3]

[ext_resource type="Script" path="res://dialogs/dialog_data.gd" id="1_data"]
[ext_resource type="Script" path="res://dialogs/dialog_line.gd" id="2_line"]
[ext_resource type="Script" path="res://dialogs/dialog_choice.gd" id="3_choice"]
[ext_resource type="Resource" path="res://data/dialogs/speakers/gatherer.tres" id="4_speaker"]

[sub_resource type="Resource" id="Resource_choice_give"]
script = ExtResource("3_choice")
text = "Hier, bitte."
next = &"thanks"

[sub_resource type="Resource" id="Resource_choice_later"]
script = ExtResource("3_choice")
text = "Noch nicht."
next = &"later"

[sub_resource type="Resource" id="Resource_ask"]
script = ExtResource("2_line")
id = &"ask"
text = "Du hast ja Äste dabei! Gibst du sie mir?"
choices = Array[ExtResource("3_choice")]([SubResource("Resource_choice_give"), SubResource("Resource_choice_later")])

[sub_resource type="Resource" id="Resource_thanks"]
script = ExtResource("2_line")
id = &"thanks"
text = "Danke, jetzt wird es warm! Nimm diese Kunai dafür, ich brauche sie nicht."
next = &"end"
hand_in_mission = &"branches"

[sub_resource type="Resource" id="Resource_later"]
script = ExtResource("2_line")
id = &"later"
text = "Gut, ich warte hier. Aber nicht zu lange, mir ist kalt."

[resource]
script = ExtResource("1_data")
speaker = ExtResource("4_speaker")
lines = Array[ExtResource("2_line")]([SubResource("Resource_ask"), SubResource("Resource_thanks"), SubResource("Resource_later")])
