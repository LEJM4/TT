[gd_resource type="Resource" script_class="DialogData" format=3]

[ext_resource type="Script" path="res://dialogs/dialog_data.gd" id="1_data"]
[ext_resource type="Script" path="res://dialogs/dialog_line.gd" id="2_line"]
[ext_resource type="Resource" path="res://data/dialogs/speakers/hunter.tres" id="3_speaker"]

[sub_resource type="Resource" id="Resource_warning"]
script = ExtResource("2_line")
text = "Gut, dass du da bist! Rechts streift ein Höhlenmensch umher, und unten wirft eine Steinwerferin."

[sub_resource type="Resource" id="Resource_tip"]
script = ExtResource("2_line")
text = "Die Steinwerferin hält Abstand. Hinter einem Block treffen dich ihre Steine nicht."

[sub_resource type="Resource" id="Resource_sneak"]
script = ExtResource("2_line")
text = "Und noch ein Rat von mir: Halte Strg gedrückt, dann schleichst du. So hören dich die Gegner nicht."
marks_done = true
unlock = &"sneak"

[resource]
script = ExtResource("1_data")
speaker = ExtResource("3_speaker")
lines = Array[ExtResource("2_line")]([SubResource("Resource_warning"), SubResource("Resource_tip"), SubResource("Resource_sneak")])
