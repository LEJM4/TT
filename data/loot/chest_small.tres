[gd_resource type="Resource" script_class="LootTable" format=3]

[ext_resource type="Script" path="res://items/loot_table.gd" id="1_table"]
[ext_resource type="Script" path="res://items/loot_entry.gd" id="2_entry"]
[ext_resource type="Resource" path="res://data/items/arrow.tres" id="3_arrow"]
[ext_resource type="Resource" path="res://data/items/shuriken.tres" id="4_shuriken"]

[sub_resource type="Resource" id="Resource_arrow"]
script = ExtResource("2_entry")
item = ExtResource("3_arrow")
amount = 10
chance = 1.0

[sub_resource type="Resource" id="Resource_shuriken"]
script = ExtResource("2_entry")
item = ExtResource("4_shuriken")
amount = 5
chance = 0.5

[resource]
script = ExtResource("1_table")
entries = Array[ExtResource("2_entry")]([SubResource("Resource_arrow"), SubResource("Resource_shuriken")])
