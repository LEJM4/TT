[gd_scene format=3]

[ext_resource type="PackedScene" path="res://entities/npcs/npc.tscn" id="1_base"]
[ext_resource type="Script" path="res://entities/npcs/quest_giver.gd" id="2_script"]
[ext_resource type="Resource" path="res://data/skins/cavegirl2.tres" id="3_skin"]
[ext_resource type="Resource" path="res://data/dialogs/gatherer_offer.tres" id="4_offer"]
[ext_resource type="Resource" path="res://data/dialogs/gatherer_waiting.tres" id="5_waiting"]
[ext_resource type="Resource" path="res://data/dialogs/gatherer_ready.tres" id="6_ready"]
[ext_resource type="Resource" path="res://data/dialogs/gatherer_done.tres" id="7_done"]

[node name="Gatherer" instance=ExtResource("1_base")]
script = ExtResource("2_script")
mission_id = &"branches"
offer_dialog = ExtResource("4_offer")
waiting_dialog = ExtResource("5_waiting")
ready_dialog = ExtResource("6_ready")
done_dialog = ExtResource("7_done")

[node name="CharacterView" parent="."]
skin = ExtResource("3_skin")
